<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TlRoot Condition="'$(TlRoot)' == ''">../tl</TlRoot>
    <_TlDotNet Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_TlDotNet>
    <_TlDotNet Condition="'$(_TlDotNet)' == ''">dotnet</_TlDotNet>
    <_TlBakeProject>$(TlRoot)/tools/Tl.Bake/Tl.Bake.csproj</_TlBakeProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Frent" Version="0.8.0-beta" />
    <ProjectReference Include="$(TlRoot)/src/Tl.Core/Tl.Core.csproj" />
    <ProjectReference Include="$(TlRoot)/tools/Tl.Gen.Tlb/Tl.Gen.Tlb.csproj" />
    <ProjectReference Include="$(TlRoot)/src/Tl.Gen.CSharp/Tl.Gen.CSharp.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" AdditionalProperties="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>
  <Import Project="$(TlRoot)/src/Tl.Gen.CSharp/build/Tl.Gen.CSharp.targets" />
  <Target Name="BakeJumpTimeline"
          AfterTargets="Build"
          Inputs="$(MSBuildProjectDirectory)/jump.json;$(TargetPath)"
          Outputs="$(OutDir)jump.tlb">
    <MSBuild Projects="$(_TlBakeProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(_TlBakeProject)"
             Targets="GetTargetPath"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_TlbTool" />
    </MSBuild>
    <Exec Command="&quot;$(_TlDotNet)&quot; &quot;@(_TlbTool)&quot; &quot;$(MSBuildProjectDirectory)/jump.json&quot; &quot;$(OutDir)jump.tlb&quot; --assembly &quot;$(TargetPath)&quot;" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)jump.tlb" />
    </ItemGroup>
  </Target>
</Project>
